// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String            @id @default(cuid())
  username        String            @unique
  email           String            @unique
  passwordHash    String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  profile         UserProfile?
  preferences     UserPreferences?
  skills          Skill[]
  skillTrees      SkillTree[]
  quests          Quest[]
  habits          Habit[]
  philosophies    UserPhilosophy[]
  mindMaps        MindMap[]
  paths           Path[]
  achievements    UserAchievement[]
  analyticsData   AnalyticsData[]
  exportHistory   ExportHistory[]
  sessions        Session[]
  notifications   Notification[]
  feedback        Feedback[]
  gameSettings    GameSettings?
  socialProfile   SocialProfile?
  leaderboardRank LeaderboardRank?
}

model UserProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String?
  lastName    String?
  bio         String?
  avatarUrl   String?
  dateOfBirth DateTime?
  country     String?
  timezone    String?   @default("UTC")
}

model UserPreferences {
  id                  String        @id @default(cuid())
  userId              String        @unique
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme               String        @default("system")
  language            String        @default("en")
  emailNotifications  Boolean       @default(true)
  pushNotifications   Boolean       @default(true)
  dataSharing         Boolean       @default(false)
  lastLogin           DateTime?
  privacySettings     Json?
  timeFormat          String        @default("24h")
  dateFormat          String        @default("YYYY-MM-DD")
  accessibility       Json?
}

model Skill {
  id                  String              @id @default(cuid())
  userId              String
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  xp                  Int                 @default(0)
  level               Int                 @default(1)
  maxLevel            Int                 @default(100)
  category            String?
  tags                String[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  decayRate           Float?
  decayIntervalDays   Int?
  lastDecay           DateTime?
  decayEnabled        Boolean             @default(true)
  skillTreeId         String?
  skillTree           SkillTree?          @relation(fields: [skillTreeId], references: [id], onDelete: SetNull)
  pathSteps           PathStep[]
  relatedQuests       Quest[]             @relation("SkillQuests")
  achievements        UserAchievement[]
  learningResources   LearningResource[]
  skillDependencies   SkillDependency[]   @relation("SkillDependencies")
  skillPrerequisites  SkillDependency[]   @relation("SkillPrerequisites")
  practiceLogs        PracticeLog[]
  goal                SkillGoal?

  @@index([userId])
  @@index([skillTreeId])
}

model SkillDependency {
  id              String  @id @default(cuid())
  skillId         String
  skill           Skill   @relation("SkillDependencies", fields: [skillId], references: [id], onDelete: Cascade)
  prerequisiteId  String
  prerequisite    Skill   @relation("SkillPrerequisites", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([skillId, prerequisiteId])
  @@index([prerequisiteId])
}

model SkillTree {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  skills      Skill[]
  nodes       Json?
  isPublic    Boolean   @default(false)
  category    String?

  @@index([userId])
}

model Quest {
  id                  String              @id @default(cuid())
  userId              String
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  status              QuestStatus         @default(TODO)
  priority            QuestPriority       @default(MEDIUM)
  difficulty          Int?
  xpReward            Int?
  dueDate             DateTime?
  completedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  tags                String[]
  dependencies        QuestDependency[]   @relation("QuestDependencies")
  dependents          QuestDependency[]   @relation("QuestDependents")
  parentQuestId       String?
  parentQuest         Quest?              @relation("QuestChain", fields: [parentQuestId], references: [id], onDelete:SetNull)
  subQuests           Quest[]             @relation("QuestChain")
  orderIndex          Int?
  recurring           RecurringQuest?
  relatedSkills       Skill[]             @relation("SkillQuests")
  pathSteps           PathStep[]
  questTemplates      QuestTemplate[]     @relation("QuestToTemplate")
  achievementUnlocks  UserAchievement[]
  notes               String?
  estimatedTime       Int?
  actualTime          Int?

  @@index([userId])
  @@index([parentQuestId])
}

enum QuestStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum QuestPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model QuestDependency {
  id            String  @id @default(cuid())
  questId       String
  quest         Quest   @relation("QuestDependencies", fields: [questId], references: [id], onDelete: Cascade)
  dependsOnId   String
  dependsOn     Quest   @relation("QuestDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([questId, dependsOnId])
  @@index([dependsOnId])
}

model RecurringQuest {
  id            String    @id @default(cuid())
  questId       String    @unique
  quest         Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)
  pattern       String
  nextDueDate   DateTime
  endDate       DateTime?
  count         Int       @default(0)
}

model Habit {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  frequency         HabitFrequency
  target            Int?
  streak            Int             @default(0)
  longestStreak     Int             @default(0)
  lastCompletedDate DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  archived          Boolean         @default(false)
  history           HabitHistory[]
  color             String?
  reminderTime      String?
  positive          Boolean         @default(true)

  @@index([userId])
}

enum HabitFrequency {
  DAILY
  WEEKLY
  MONTHLY
  SPECIFIC_DAYS
}

model HabitHistory {
  id          String    @id @default(cuid())
  habitId     String
  habit       Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date        DateTime
  completed   Boolean
  notes       String?
  loggedAt    DateTime  @default(now())

  @@unique([habitId, date])
  @@index([habitId])
}

model UserPhilosophy {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coreValues  String[]
  mission     String?
  vision      String?
  quotes      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model MindMap {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  nodes         MindMapNode[]
  edges         MindMapEdge[]
  isPublic      Boolean       @default(false)
  layout        Json?

  @@index([userId])
}

model MindMapNode {
  id            String        @id @default(cuid())
  mindMapId     String
  mindMap       MindMap       @relation(fields: [mindMapId], references: [id], onDelete: Cascade)
  label         String
  content       String?
  xPosition     Float?
  yPosition     Float?
  color         String?
  shape         String?
  parentNodeId  String?
  parentNode    MindMapNode?  @relation("NodeHierarchy", fields: [parentNodeId], references: [id], onDelete:NoAction, onUpdate:NoAction)
  childNodes    MindMapNode[] @relation("NodeHierarchy")
  edgesFrom     MindMapEdge[] @relation("EdgeSource")
  edgesTo       MindMapEdge[] @relation("EdgeTarget")

  @@index([mindMapId])
  @@index([parentNodeId])
}

model MindMapEdge {
  id            String      @id @default(cuid())
  mindMapId     String
  mindMap       MindMap     @relation(fields: [mindMapId], references: [id], onDelete:Cascade)
  sourceId      String
  sourceNode    MindMapNode @relation("EdgeSource", fields: [sourceId], references: [id], onDelete:Cascade)
  targetId      String
  targetNode    MindMapNode @relation("EdgeTarget", fields: [targetId], references: [id], onDelete:Cascade)
  label         String?
  animated      Boolean?    @default(false)

  @@unique([sourceId, targetId, mindMapId])
  @@index([mindMapId])
  @@index([targetId])
}

model Path {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?
  color       String?    @default("blue")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps       PathStep[]

  @@index([userId])
}

model PathStep {
  id             String    @id @default(cuid())
  pathId         String
  title          String
  description    String?
  order          Int
  relatedSkillId String?
  relatedQuestId String?
  completed      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  path           Path      @relation(fields: [pathId], references: [id], onDelete: Cascade)
  relatedSkill   Skill?    @relation(fields: [relatedSkillId], references: [id], onDelete: SetNull)
  relatedQuest   Quest?    @relation(fields: [relatedQuestId], references: [id], onDelete: SetNull)

  @@unique([pathId, order], name: "pathOrder")
  @@index([pathId])
  @@index([relatedSkillId])
  @@index([relatedQuestId])
}

enum PathStepType {
  TASK
  SKILL_GOAL
  QUEST_LINK
  MILESTONE
}

model Achievement {
  id            String            @id @default(cuid())
  name          String            @unique
  description   String
  criteria      String
  iconUrl       String?
  points        Int?              @default(0)
  category      String?
  level         Int?
  color         String?
  secret        Boolean           @default(false)
  userUnlocks   UserAchievement[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())
  notified      Boolean     @default(false)
  progress      Json?
  skillId       String?
  skill         Skill?      @relation(fields: [skillId], references: [id], onDelete:SetNull)
  questId       String?
  quest         Quest?      @relation(fields: [questId], references: [id], onDelete:SetNull)

  @@unique([userId, achievementId])
  @@index([achievementId])
  @@index([skillId])
  @@index([questId])
}

model QuestTemplate {
  id              String            @id @default(cuid())
  name            String            @unique
  description     String?
  category        String?
  difficulty      Int?
  xpReward        Int?
  tags            String[]
  templateData    Json
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  questInstances  Quest[]           @relation("QuestToTemplate")
  recommendations Recommendation[]
}

model Recommendation {
  id              String              @id @default(cuid())
  userId          String
  title           String
  description     String
  type            RecommendationType
  relatedSkillId  String?
  relatedQuestId  String?
  relatedPathId   String?
  questTemplateId String?
  questTemplate   QuestTemplate?      @relation(fields: [questTemplateId], references: [id], onDelete:SetNull)
  resourceLink    String?
  reason          String?
  priority        Int                 @default(0)
  viewed          Boolean             @default(false)
  accepted        Boolean             @default(false)
  createdAt       DateTime            @default(now())

  @@index([userId])
  @@index([relatedSkillId])
  @@index([relatedQuestId])
  @@index([relatedPathId])
  @@index([questTemplateId])
}

enum RecommendationType {
  SKILL
  QUEST
  PATH
  RESOURCE
  HABIT
}

model AnalyticsData {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime
  type        String
  data        Json
  createdAt   DateTime  @default(now())

  @@index([userId, date])
  @@index([type])
}

model ExportHistory {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  format        String
  status        String
  fileUrl       String?
  error         String?
  requestedAt   DateTime  @default(now())
  completedAt   DateTime?

  @@index([userId])
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  ipAddress   String?
  userAgent   String?

  @@index([userId])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  message     String
  isRead      Boolean   @default(false)
  link        String?
  createdAt   DateTime  @default(now())

  @@index([userId, isRead])
}

model Feedback {
  id          String    @id @default(cuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete:SetNull)
  type        String
  message     String
  email       String?
  status      String    @default("received")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model GameSettings {
  id                  String  @id @default(cuid())
  userId              String  @unique
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  animationsEnabled   Boolean @default(true)
  soundEffectsLevel   Float   @default(0.5)
  musicLevel          Float   @default(0.5)
  difficultyScaling   Float   @default(1.0)
  tutorialSeen        Json?
}

model SocialProfile {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName   String?
  profileUrl    String?
  friends       Json?
}

model LeaderboardRank {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  score         Int
  rank          Int
  lastUpdated   DateTime  @updatedAt
  period        String

  @@index([score])
  @@index([period, rank])
}

model LearningResource {
  id          String        @id @default(cuid())
  skillId     String
  skill       Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  title       String
  url         String?
  type        ResourceType  @default(ARTICLE)
  notes       String?
  completed   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([skillId])
}

enum ResourceType {
  ARTICLE
  VIDEO
  COURSE
  BOOK
  TOOL
  OTHER
}

model PracticeLog {
  id          String    @id @default(cuid())
  skillId     String
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  startTime   DateTime
  endTime     DateTime
  duration    Int
  notes       String?
  xpGained    Int?      @default(0)
  createdAt   DateTime  @default(now())

  @@index([skillId])
}

model SkillGoal {
  id            String    @id @default(cuid())
  skillId       String    @unique
  skill         Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  targetLevel   Int?
  targetXp      Int?
  deadline      DateTime?
  description   String?
  achieved      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
